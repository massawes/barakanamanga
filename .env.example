# Copy this file to .env and change both passwords before the first start.
DB_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-site-password

# Port the website listens on: http://server-ip:8080/
# Not 80, so it never clashes with an Apache already running on the server.
WEB_PORT=8080

# 0.0.0.0 = reachable from the internet on WEB_PORT.
# 127.0.0.1 = only the server itself can reach it (use this when the
# existing Apache forwards a domain to it; see DOCKER.md).
WEB_BIND=0.0.0.0
