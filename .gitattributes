# Never let line-ending conversion touch documents or media
*.pdf binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary

# Files over 50 MB live in Git LFS (only in the massawes/namanga archive)
uploads/gallery/*.mp4 filter=lfs diff=lfs merge=lfs -text
EXMSVICENTNAMANGA/**/MARKING?SCHEME?MOCK?KANDA?F,4?ARUSHA.pdf filter=lfs diff=lfs merge=lfs -text
