# Prevent any script execution inside the uploads folder.
# Uploaded files must only ever be served as static files,
# never executed, no matter what extension ends up here.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Apache 2.4+ handler-based PHP (FPM/CGI setups)
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

# No "Options -ExecCGI" / "AddHandler cgi-script" here: InfinityFree
# rejects those directives and answers every request in uploads/ with a
# 500 error. The FilesMatch block above already refuses script files.

# HTML/SVG files (e.g. student task uploads) must never be rendered as a
# page on this site — always force them to download as a file instead.
<FilesMatch "\.(html|htm|svg)$">
    ForceType application/octet-stream
    <IfModule mod_headers.c>
        Header set Content-Disposition attachment
        Header set X-Content-Type-Options nosniff
    </IfModule>
</FilesMatch>
